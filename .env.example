# Entorno y Servidor
NODE_ENV=production
PORT=8081
CLIENT_URL=https://sweethomeandboutiquecr.com

# Base de datos (MongoDB). Local y producción NO deberían compartir la misma base.
DATABASE_URL="mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/sweet_home?retryWrites=true&w=majority"

# Autenticación Admin & Seguridad (genera una clave larga y aleatoria: openssl rand -hex 48)
JWT_SECRET="CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_MAS_DE_32_CARACTERES"
JWT_EXPIRES_IN="7d"

# Administradoras iniciales (solo para el seed de desarrollo; SIN contraseñas reales en este archivo)
INITIAL_ADMIN_NAME="Vanessa"
INITIAL_ADMIN_EMAIL="admin@sweethomeandboutiquecr.com"
INITIAL_ADMIN_PASSWORD="DEFINIR_UNA_CONTRASENA_LARGA_Y_UNICA"

JENDRY_ADMIN_NAME="Jendry Zúñiga"
JENDRY_ADMIN_EMAIL="jendry@sweethomeandboutiquecr.com"
JENDRY_ADMIN_PASSWORD="DEFINIR_OTRA_CONTRASENA_LARGA_Y_UNICA"

# Datos de Negocio (Costa Rica)
STORE_NAME="Sweet Home & Boutique CR"
STORE_PHONE="+506 0000-0000"
STORE_WHATSAPP="50600000000"
STORE_EMAIL="info@sweethomeandboutiquecr.com"
SINPE_PHONE="0000-0000"
SINPE_HOLDER="Sweet Home & Boutique CR"

# Almacenamiento
STORAGE_DRIVER=local
UPLOAD_DIR="server/uploads"
